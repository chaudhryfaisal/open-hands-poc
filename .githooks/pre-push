#!/bin/bash
# Pre-push hook for Rust projects
# This hook runs comprehensive checks before pushing to remote

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

print_status() {
    echo -e "${BLUE}[HOOK]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

print_status "Running pre-push checks..."

# Get the remote and URL
remote="$1"
url="$2"

# Read from stdin to get the list of refs being pushed
while read local_ref local_sha remote_ref remote_sha; do
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        # Branch is being deleted, skip checks
        continue
    fi
    
    print_status "Checking branch: $(echo $remote_ref | sed 's/refs\/heads\///')"
    
    # 1. Ensure we're not pushing to protected branches without proper checks
    branch_name=$(echo $remote_ref | sed 's/refs\/heads\///')
    if [[ "$branch_name" == "main" || "$branch_name" == "master" ]]; then
        print_warning "Pushing to protected branch: $branch_name"
        
        # Check if this is a direct push (not from a merge)
        if [ "$remote_sha" != "0000000000000000000000000000000000000000" ]; then
            # Check if the push is fast-forward
            if ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
                print_error "Non-fast-forward push to $branch_name detected!"
                print_error "This might overwrite history. Use --force-with-lease if intentional."
                exit 1
            fi
        fi
    fi
    
    # 2. Run full test suite
    print_status "Running comprehensive test suite..."
    if ! cargo test --all --release; then
        print_error "Tests failed in release mode"
        exit 1
    fi
    
    # 3. Check for clippy warnings in release mode
    print_status "Running Clippy in release mode..."
    if ! cargo clippy --all-targets --all-features --release -- -D warnings; then
        print_error "Clippy found issues in release mode"
        exit 1
    fi
    
    # 4. Ensure code is formatted
    print_status "Verifying code formatting..."
    if ! cargo fmt --all -- --check; then
        print_error "Code is not properly formatted"
        exit 1
    fi
    
    # 5. Check for security vulnerabilities
    if command -v cargo-audit &> /dev/null; then
        print_status "Running security audit..."
        if ! cargo audit; then
            print_error "Security vulnerabilities found"
            exit 1
        fi
    fi
    
    # 6. Verify documentation builds
    print_status "Checking documentation..."
    if ! cargo doc --all --no-deps; then
        print_error "Documentation build failed"
        exit 1
    fi
    
    # 7. Check for outdated dependencies
    if command -v cargo-outdated &> /dev/null; then
        print_status "Checking for outdated dependencies..."
        outdated_output=$(cargo outdated --exit-code 1 2>/dev/null || true)
        if [ -n "$outdated_output" ]; then
            print_warning "Outdated dependencies found:"
            echo "$outdated_output"
            print_warning "Consider updating dependencies before pushing"
        fi
    fi
    
    # 8. Check binary sizes (warn if too large)
    print_status "Checking binary sizes..."
    cargo build --release --all-targets
    find target/release -maxdepth 1 -type f -executable | while read binary; do
        if [ -f "$binary" ]; then
            size=$(stat -f%z "$binary" 2>/dev/null || stat -c%s "$binary" 2>/dev/null || echo 0)
            size_mb=$((size / 1024 / 1024))
            if [ $size_mb -gt 50 ]; then
                print_warning "Large binary detected: $(basename $binary) (${size_mb}MB)"
            fi
        fi
    done
    
    # 9. Check for sensitive information
    print_status "Scanning for sensitive information..."
    sensitive_patterns=(
        "password\s*=\s*['\"][^'\"]*['\"]"
        "secret\s*=\s*['\"][^'\"]*['\"]"
        "api_key\s*=\s*['\"][^'\"]*['\"]"
        "token\s*=\s*['\"][^'\"]*['\"]"
        "-----BEGIN.*PRIVATE KEY-----"
    )
    
    for pattern in "${sensitive_patterns[@]}"; do
        if git diff --name-only "$remote_sha".."$local_sha" | xargs grep -l -E "$pattern" 2>/dev/null; then
            print_error "Potential sensitive information found in commits"
            print_error "Pattern: $pattern"
            exit 1
        fi
    done
    
    # 10. Verify commit messages
    print_status "Checking commit messages..."
    git rev-list "$remote_sha".."$local_sha" | while read commit; do
        msg=$(git log --format=%B -n 1 "$commit" | head -n 1)
        if [ ${#msg} -lt 10 ]; then
            print_warning "Short commit message in $commit: $msg"
        fi
        if [ ${#msg} -gt 72 ]; then
            print_warning "Long commit message in $commit (${#msg} chars)"
        fi
    done
    
done

print_success "All pre-push checks passed! 🚀"
print_status "Push proceeding..."